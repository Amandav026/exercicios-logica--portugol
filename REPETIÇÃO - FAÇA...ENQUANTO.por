programa{
	funcao inicio(){
	  real A
	  real B
	  real resultado

	  escreva("Digite o 1° valor: ")
	  leia(A)
	  escreva("\n")


       faca{
	  escreva("Digite o 2° valor (não pode ser zero): ")
	  leia(B)
	  escreva("\n")
	  	se(B==0){
               escreva("Valor inválido! O segundo valor não pode ser zero")
               escreva("\n")
	  	}
	  } enquanto(B==0)
	      resultado = A / B
	      escreva("O resultado da divisão é: ", resultado)
	}
	  	
	  


	  
	
}
