programa{
	funcao inicio(){
	  inteiro comeco
	  inteiro fim
	  inteiro duracao

	  escreva("Digite a hora inicial do jogo: ")
	  leia(comeco)
	  escreva("\n")

	  escreva("Digite a hora do término do jogo: ")
	  leia(fim)
	  escreva("\n")

	  duracao = 24 - comeco + fim

	  escreva("A duração do jogo foi de: ", duracao, " ", "horas")
	  
	  
	  
	}
}
