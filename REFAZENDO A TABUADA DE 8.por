programa{
	funcao inicio(){
        inteiro i
        inteiro resultado


       escreva("Tabuada de 8: ")
        	escreva("\n")
        	
        para(i=1;i<=10;i++){
       
        	resultado = 8 * i
        	escreva("8 x ", i, " = ", resultado)
        	escreva("\n")
        }
        	
        }

	   
	
}
