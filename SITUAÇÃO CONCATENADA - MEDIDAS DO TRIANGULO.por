programa{
	funcao inicio(){
	  inteiro A
       inteiro B
       inteiro C
       

       escreva("Digite o valor da medida do lado A do triângulo: ")
       leia(A)
       escreva("\n")

       escreva("Digite o valor da medida do lado B do triângulo: ")
       leia(B)
       escreva("\n")

       escreva("Digite o valor da medida do lado C do triângulo: ")
       leia(C)
       escreva("\n")

       se(A<B+C e B<A+C e C<B+A){
       	escreva("As medidas formam um triângulo")
       }senao{
       	escreva("As medidas não formam um triângulo")
       }

     
       
       

       
	}
}
