programa{
	funcao inicio(){
	  real A
	  real B
	  real C
	  

	  escreva("Digite o 1° valor da medida do triângulo: ")
	  leia(A)
	  escreva("\n")

       escreva("Digite o 2° valor da medida do triângulo: ")
	  leia(B)
	  escreva("\n")

       escreva("Digite o 3° valor da medida do triângulo: ")
	  leia(C)
	  escreva("\n")


	  se(A<B+C e B<A+C e C<A+B){
	  	escreva("Formam um triângulo")
	  }senao{
	  	escreva("Não formam um triângulo")
	  }
	  		
	  
	  
	  	}
	  	
	  
	  
	
}
