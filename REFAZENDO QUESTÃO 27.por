programa{
	funcao inicio(){
	  real valor

	  escreva("Digite o valor: ")
	  leia(valor)
	  escreva("\n")

	  se(valor>0){
	  	escreva("POSITIVO")
	  }senao se(valor<0){
	  	escreva("NEGATIVO")
	  }senao{
	  	escreva("ZERO")
	  }
	  
	}
}
