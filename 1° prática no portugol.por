programa {
	funcao inicio() {
	real Nota1, Nota2, media
	leia(Nota1, Nota2)
	media = (Nota1 + Nota2)/2
	se (media >= 7) {
	escreva ("aprovado")}
	senao {
	escreva ("reprovado")
	}
	
		
		
  }
}
