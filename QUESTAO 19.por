programa {
	funcao inicio(){
	  inteiro valorUm
	  inteiro valorDois

	  escreva("Digite o 1° valor: ")
	  leia(valorUm)
	  escreva("\n")

	  escreva("Digite o 2° valor: ")
	  leia(valorDois)
	  escreva("\n")

	  se(valorUm>valorDois){
	  	escreva("O 1° valor é o maior: ", valorUm)
	  }senao{
	  	escreva(" O 2° valor é o maior: ", valorDois)
	  } 
	  
	}
}
