programa {
funcao inicio() {

cadeia paises[3]
inteiro contador

paises [0] = "Brasil"
paises [1] = "Argentina"
paises [2] = "Holanda"

para(contador=0;contador<3;contador++){
	escreva(paises[contador])
	escreva("\n")
}

	}
}
