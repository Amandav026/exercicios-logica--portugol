programa{
	funcao inicio(){
	  inteiro N
	  inteiro i

	  faca{
	  	escreva("Digite um valor maior que zero: ")
	  	leia(N)
	  	escreva("\n")
	  }
	  enquanto(N==0)	   
	   escreva("\n")
	  

	   para(i=1;i<=N;i++){
	   	escreva(i)
	   	escreva("\n")
	   }
	  
	}
}
