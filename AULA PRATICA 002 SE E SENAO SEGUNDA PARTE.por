programa {
funcao inicio() {
inteiro temperatura

escreva("Informe a temperatura: ")
leia(temperatura)

se(temperatura<20){
escreva("Está frio, coloque um casaco!")
}senao {
escreva("O tempo está agradável!")
}
  }
}
