programa {
funcao inicio() {
inteiro diadasemana

escreva("Digite o número que corresponde ao dia da semana (1-7): ")
leia(diadasemana)

escolha(diadasemana){
	caso 1:
	escreva("Domingo")
	pare

	caso 2:
	escreva("Segunda-feira")
	pare

	caso 3:
	escreva("Terça-feira")
	pare

	caso 4:
	escreva("Quarta-feira")
	pare

	caso 5:
	escreva("Quinta-feira")
	pare

	caso 6:
	escreva("Sexta-feira")
	pare

	caso 7:
	escreva("Sábado")
	pare

	caso contrario:
	escreva("Número inválido. Digite um número de 1 a 7.")
}

	
}
  }

