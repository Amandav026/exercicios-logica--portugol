programa{
	funcao inicio(){
	  real A
	  real B

	  escreva("Digite o valor 1: ")
	  leia(A)
	  escreva("\n")

	  escreva("Digite o valor 2: ")
	  leia(B)
	  escreva("\n")

	  se(A==B){
	  	escreva("Números iguais")
	  }senao se(A>B){
	  	escreva("Primeiro é maior")
	  }senao{
	  	escreva("Segundo maior")
	  }
	  
	}
}
