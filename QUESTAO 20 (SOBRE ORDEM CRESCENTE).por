programa {
	funcao inicio(){
	  inteiro A
	  inteiro B

	
	  escreva("Digite o 1° valor: ")
	  leia(A)
	  escreva("\n")

	  escreva("Digite o 2° valor: ")
	  leia(B)
	  escreva("\n")

	  se(A<B){
	  	escreva(A, " ",B)
	  }senao{
	  	escreva(B, " ",A)
	  }
	  

	  

       

	  
	}
}
