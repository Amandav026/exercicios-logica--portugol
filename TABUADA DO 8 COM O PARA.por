programa{
	funcao inicio(){
	inteiro A
	inteiro resultado 

	escreva("Tabuada do 8: ")
	escreva("\n")

	para(A=1;A<=10;A++){
		resultado = 8 * A
		escreva("8 x ", A, " = ", resultado, "\n")
	}
	
	}
}
